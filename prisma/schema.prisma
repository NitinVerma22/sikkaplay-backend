// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(uuid())
  phoneNumber     String        @unique
  email           String?       // Stored for Google Login users
  firebaseUid     String        @unique
  passwordHash    String?
  name            String?
  avatarUrl       String?
  city            String?
  username        String?       @unique
  bio             String?
  referralCode    String        @unique
  referredBy      String?
  balance         Int           @default(0)
  referralBalance Int           @default(0) // Earnings from MLM/Referrals
  fcmToken        String?       // Firebase Cloud Messaging Token
  deviceId        String?       // Unique Device ID to prevent fraud
  upiId           String?       // User's preferred UPI ID for withdrawal
  totalEarned     Int           @default(0)
  withdrawalAmount Int          @default(0)
  bubbleShooterLevel Int        @default(1)
  waterSortLevel     Int        @default(1)
  isBlocked       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  transactions    Transaction[]
  dailyUsages     DailyUsage[]
  referralRewards ReferralReward[]
  notifications   Notification[]
  tickets         SupportTicket[]
  dailyCodeClaims DailyCodeClaim[]
  gameSessions    GameSession[]
  adImpressions   AdImpression[]
  socialTaskClaims SocialTaskClaim[]
  adStats         AdStats[]
  playgroundMinutes Int                 @default(0)
  gender            String?
  crateProgress     CrateProgress[]
  friendshipsOne    Friendship[]        @relation("UserOneFriendships")
  friendshipsTwo    Friendship[]        @relation("UserTwoFriendships")
  giftInventory     UserGiftInventory[]
  bans              PlaygroundBan[]
  blocksInitiated   BlockedUser[]       @relation("BlocksInitiated")
  blocksReceived    BlockedUser[]       @relation("BlocksReceived")

  @@index([balance])
  @@index([totalEarned])
  @@index([referredBy])
  @@index([isBlocked])
  @@index([deviceId])
}

model GameSession {
  id          String    @id @default(uuid())
  userId      String
  gameType    String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  status      String    @default("active") // "active", "completed", "invalidated"
  coinsEarned Int       @default(0)
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id                  String   @id @default(uuid())
  amount              Int
  type                String   // 'earning', 'withdrawal', 'bonus'
  status              String   // 'success', 'pending', 'failed'
  description         String
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  createdAt           DateTime @default(now())
  isReferralProcessed Boolean  @default(false)
  externalTransactionId String?  @unique
  withdrawalOptionId    String?

  @@index([userId])
  @@index([userId, status])
  @@index([createdAt])
  @@index([type])
  @@index([status])
}

model DailyUsage {
  id          String   @id @default(uuid())
  userId      String
  dateStr     String   // YYYY-MM-DD format for easy querying
  gamesMinutes Int      @default(0)
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dateStr])
}

model ReferralReward {
  id          String   @id @default(uuid())
  userId      String   // The user who achieved the milestone
  referrerId  String   // The user who received the reward
  milestone   String   // 'signup_bonus', '1_hour', '10_hours', 'daily_50', '30_days_jackpot'
  dateStr     String?  // YYYY-MM-DD for daily recurring rewards
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  // Ensure a milestone is only rewarded once (or once per day if dateStr is set)
  @@unique([userId, milestone, dateStr])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  body      String
  type      String   // e.g., 'referral', 'reward', 'withdrawal', 'alert'
  isRead    Boolean  @default(false)
  userId    String
  user        User     @relation(fields: [userId], references: [id])
  bannerUrl String?  // Optional banner image URL
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model FAQ {
  id       String @id @default(uuid())
  question String
  answer   String
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  mobile      String
  issue       String
  status      String   @default("pending") // pending, in_progress, resolved
  reply       String?  // Admin's reply
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed password
  role      String   @default("superadmin") // superadmin, moderator
  createdAt DateTime @default(now())
}

model AppConfig {
  id                  String   @id @default(uuid())
  gullakMaxSize       Int      @default(100) // Max coins Gullak can hold
  dailyStreakCoins    Int      @default(50)  // Base coins for daily streak
  referralBonus       Int      @default(500) // Coins rewarded for successful referral
  commissionRate      Float    @default(0.10) // 10% commission on MLM network withdrawals
  minWithdrawalLimit  Int      @default(1000) // Minimum coins required to withdraw
  apkDownloadUrl      String   @default("https://sikkaplay-apk.web.app/app-release.apk")
  latestAppVersion    String   @default("1.0.9")
  forceUpdate         Boolean  @default(false)
  showVideoTutorialBar Boolean @default(true)
  telegramLink        String   @default("https://t.me/sikkaplay")
  whatsappLink        String   @default("https://whatsapp.com/channel/sikkaplay")
  groupLink           String   @default("https://t.me/sikkaplay_group")
  
  // Watch & Earn Milestones
  watchM1Mins         Int      @default(20)
  watchM1Coins        Int      @default(50)
  watchM2Mins         Int      @default(60)
  watchM2Coins        Int      @default(200)
  watchM3Mins         Int      @default(180)
  watchM3Coins        Int      @default(600)
  
  // Play & Earn Milestones
  playM1Mins          Int      @default(20)
  playM1Coins         Int      @default(40)
  playM2Mins          Int      @default(50)
  playM2Coins         Int      @default(90)
  playM3Mins          Int      @default(99)
  playM3Coins         Int      @default(180)

  // Daily Tasks Coins Configuration
  dailyCodeTaskCoins  Int      @default(10)
  visitAllTaskCoins   Int      @default(30)

  // Ad Management Configurations
  adsEnabled          Boolean  @default(true)
  allowMultiAccounts  Boolean  @default(false) // Toggle to permit/deny multiple accounts per device
  rewardedCapPerDay   Int      @default(15)
  dailyCodeAdRequired Boolean  @default(true)
  surveysAdRequired   Boolean  @default(true)

  vpnDetectionEnabled Boolean  @default(false)
  vpnApiKey           String   @default("")
  maintenanceMode     Boolean  @default(false)

  // Referral Withdrawal eligibility conditions
  refWithdrawMinPlaytimeMins  Int      @default(3000)
  refWithdrawMinReferrals     Int      @default(2)

  // Dynamic Gullak Claim Ads Sequence
  gullakAdSequence            String   @default("interstitial,rewarded,none")

  // Database Retention Settings (in Days)
  gameSessionRetentionDays    Int      @default(1)
  adImpressionRetentionDays   Int      @default(7)
  notificationRetentionDays   Int      @default(30)
  dailyUsageRetentionDays     Int      @default(45)
  visitEarnClaimRetentionDays Int      @default(1)

  // Playground Configs
  playgroundCoinsPerMinute   Int      @default(240) // 1200 coins = 5 mins -> 240 coins/min
  playgroundMaleFilterCost   Int      @default(50)
  playgroundFemaleFilterCost Int      @default(50)
  giftCommissionRate         Float    @default(0.20) // 20% platform commission on virtual gifts
  selfWithdrawalNotice       String   @default("")
  referralWithdrawalNotice   String   @default("")
  showWithdrawalPackages     Boolean  @default(true)

  updatedAt           DateTime @updatedAt
}

model DailyCode {
  id         String   @id @default(uuid())
  code       String   @unique
  coins      Int      @default(0)
  maxClaims  Int      @default(1)
  activeDate String?  // YYYY-MM-DD
  createdAt  DateTime @default(now())
  claims     DailyCodeClaim[]
}

model DailyCodeClaim {
  id          String    @id @default(uuid())
  dailyCodeId String
  userId      String
  coinsEarned Int
  createdAt   DateTime  @default(now())
  dailyCode   DailyCode @relation(fields: [dailyCodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialTask {
  id          String   @id @default(uuid())
  platform    String   // 'facebook', 'instagram', 'whatsapp', 'telegram', 'youtube', 'other'
  title       String
  link        String
  coinsReward Int      @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  claims      SocialTaskClaim[]
}

model SocialTaskClaim {
  id           String     @id @default(uuid())
  userId       String
  socialTaskId String
  claimedAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialTask   SocialTask @relation(fields: [socialTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, socialTaskId])
}

model VisitEarnLink {
  id           String   @id @default(uuid())
  title        String
  url          String
  rewardAmount Int      @default(5)
  timerSeconds Int      @default(15)
  createdAt    DateTime @default(now())
}

model VisitEarnClaim {
  id        String   @id @default(uuid())
  userId    String
  linkId    String
  claimedAt DateTime @default(now())

  @@index([userId, linkId])
  @@index([userId])
  @@index([claimedAt])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  action     String
  details    String
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model AdImpression {
  id               String   @id @default(uuid())
  userId           String
  adType           String
  adNetwork        String
  coinsAwarded     Int      @default(0)
  externalTxId     String?  @unique
  verifiedByServer Boolean  @default(false)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AdStats {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime
  totalAdsWatched Int      @default(0)
  rewardedAds     Int      @default(0)
  interstitialAds Int      @default(0)
  coinsEarned     Int      @default(0)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

enum CrateLevel {
  BRONZE
  SILVER
  GOLD
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model CrateProgress {
  id              String       @id @default(uuid())
  userId          String
  dateStr         String       // YYYY-MM-DD
  activeSeconds   Int          @default(0)
  bronzeClaimed   Boolean      @default(false)
  silverClaimed   Boolean      @default(false)
  goldClaimed     Boolean      @default(false)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateStr])
}

model Friendship {
  id            String           @id @default(uuid())
  userOneId     String
  userTwoId     String
  status        FriendshipStatus @default(PENDING)
  actionUserId  String           // Who sent the request
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userOne       User             @relation("UserOneFriendships", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo       User             @relation("UserTwoFriendships", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model HiddenChat {
  id          String   @id @default(uuid())
  userId      String
  channelName String
  hiddenAt    DateTime @default(now())

  @@unique([userId, channelName])
  @@index([userId])
}

model PlaygroundSession {
  id            String         @id @default(uuid())
  channelName   String         @unique
  userOneId     String
  userTwoId     String
  startTime     DateTime       @default(now())
  endTime       DateTime?
  status        String         @default("active") // "active", "completed"
}

model Gift {
  id           String          @id @default(uuid())
  name         String          // Rose, Chocolate, Ring
  coinsPrice   Int
  imageUrl     String
  txs          GiftTransaction[]
  userGifts    UserGiftInventory[]
}

model UserGiftInventory {
  id         String   @id @default(uuid())
  userId     String
  giftId     String
  count      Int      @default(1)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift       Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@unique([userId, giftId])
}

model GiftTransaction {
  id            String            @id @default(uuid())
  senderId      String
  receiverId    String
  giftId        String
  gift          Gift              @relation(fields: [giftId], references: [id])
  coinsSpent    Int
  createdAt     DateTime          @default(now())
}

model PlaygroundReport {
  id            String         @id @default(uuid())
  reporterId    String
  reportedId    String
  reason        String
  createdAt     DateTime       @default(now())
}

model PlaygroundBan {
  id            String         @id @default(uuid())
  userId        String
  expiresAt     DateTime
  reason        String
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlaygroundMessage {
  id          String   @id @default(uuid())
  channelName String
  senderId    String
  text        String
  isSeen      Boolean  @default(false)
  reaction    String?
  createdAt   DateTime @default(now())

  @@index([channelName, isSeen])
}

model AppOffer {
  id           String   @id @default(uuid())
  offerId      String   @unique
  title        String
  description  String
  size         String
  rewardAmount Int
  iconName     String
  iconBg       String
  enabled      Boolean  @default(true)
  claimCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AppOfferClaim {
  id         String   @id @default(uuid())
  userId     String
  offerId    String
  createdAt  DateTime @default(now())

  @@unique([userId, offerId])
}

model WithdrawalOption {
  id            String   @id @default(uuid())
  earningType   String
  coins         Int
  baseRupees    Int
  bonusRupees   Int
  totalRupees   Int
  netUpi        Int
  cashbackCoins Int
  badge         String   @default("")
  tagline       String   @default("")
  iconName      String   @default("account_balance_wallet_rounded")
  iconBg        String   @default("#6366F1")
  color         String   @default("#6366F1")
  buttonColor   String   @default("#4F46E5")
  lightBg       String   @default("#EEF2FF")
  enabled       Boolean  @default(true)
  claimCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoTutorial {
  id        String   @id @default(uuid())
  title     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}