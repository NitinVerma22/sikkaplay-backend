# Tapjoy Offerwall self-managed currency
# Set the same secret in the Tapjoy Virtual Currency dashboard and the backend runtime.
TAPJOY_VIRTUAL_CURRENCY_SECRET=

# TimeWall Offerwall postback
# Set this to the Secret Key shown by TimeWall for the Sikka Play placement.
TIMEWALL_SECRET_KEY=

# AdScaleX Offerwall S2S reward callback
# Set the signing secret generated by AdScaleX in the backend runtime only.
ADSCALEX_SIGNING_SECRET=
# Sikka reward coins per 1 USD of AdScaleX payout.
ADSCALEX_POINTS_PER_USD=85000
# Optional safety check: set this to the publisher app ID from AdScaleX.
ADSCALEX_PUBLISHER_APP_ID=
